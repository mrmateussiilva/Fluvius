PROJECT_NAME="Fluvius"
API_V1_STR="/api"

# Default is SQLite. For Postgres local:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/fluvius"
DATABASE_URL="sqlite:///./fluvius.db"

# Browser/frontend -> backend
FRONTEND_ORIGIN="http://localhost:5173"
PUBLIC_API_BASE_URL="http://localhost:8000"

# Backend host -> Evolution API
EVOLUTION_BASE_URL="http://localhost:8080"
EVOLUTION_API_KEY="dev_fluvius_change_me"

# Evolution API container -> backend host.
# Fallback on Linux if host.docker.internal is unavailable: http://172.17.0.1:8000
WEBHOOK_PUBLIC_BASE_URL="http://host.docker.internal:8000"

# CORS for local Vite development.
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Security & Auth
JWT_SECRET_KEY="super-secret-key-change-it-in-production"
EVOLUTION_WEBHOOK_SECRET="generate-a-strong-token-for-webhooks"
